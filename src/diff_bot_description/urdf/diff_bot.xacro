  <child link="camera_1"/>
</joint> -->

<joint name="castor_wheel" type="fixed">
  <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="castor_wheel_1"/>
</joint>

</robot>
