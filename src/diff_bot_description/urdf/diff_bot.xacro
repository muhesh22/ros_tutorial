<link name="castor_wheel_1">
  <inertial>
    <origin xyz="0.09 6.168348473141367e-18 -0.019545454545454543" rpy="0 0 0"/>
    <mass value="0.19536517515123722"/>
    <inertia ixx="9.6e-05" iyy="9.6e-05" izz="0.000134" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.05" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find diff_bot_description)/meshes/castor_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.05" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find diff_bot_description)/meshes/castor_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="right_wheel" type="continuous">
  <origin xyz="-0.1 -0.165 0.1" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="left_wheel" type="continuous">
  <origin xyz="-0.1 0.165 0.1" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

