<?xml version="1.0" ?>
<robot name="diff_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find diff_bot_description)/urdf/materials.xacro" />
<xacro:include filename="$(find diff_bot_description)/urdf/diff_bot.trans" />
<xacro:include filename="$(find diff_bot_description)/urdf/diff_bot.gazebo" />
<xacro:include filename="$(find diff_bot_description)/urdf/lidar.xacro" />
<xacro:include filename="$(find diff_bot_description)/urdf/camera.xacro" />
<link name="base_link">
  <inertial>
    <origin xyz="-0.0001550322267581235 -2.127739672160312e-17 0.12593737077845393" rpy="0 0 0"/>
    <mass value="14.498982506076695"/>
    <inertia ixx="0.136029" iyy="0.135697" izz="0.215642" ixy="-0.0" iyz="-0.0" ixz="-5.8e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find diff_bot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find diff_bot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="right_wheel_1">
  <inertial>
    <origin xyz="0.0 -0.024999999999999994 0.0" rpy="0 0 0"/>
    <mass value="1.4608405839192535"/>
    <inertia ixx="0.003956" iyy="0.007304" izz="0.003956" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.1 0.165 -0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find diff_bot_description)/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.1 0.165 -0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find diff_bot_description)/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="left_wheel_1">
  <inertial>
    <origin xyz="0.0 0.024999999999999994 0.0" rpy="0 0 0"/>
    <mass value="1.4608405839192535"/>
    <inertia ixx="0.003956" iyy="0.007304" izz="0.003956" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.1 -0.165 -0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find diff_bot_description)/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.1 -0.165 -0.1" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find diff_bot_description)/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

